# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME="KTUfy Backend API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT Configuration (for your own JWT operations if needed)
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Redis Configuration (for Celery - will set up later)
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════════════
# Neo4j Configuration (Knowledge Graph)
# ═══════════════════════════════════════════════════════════════════════════════
NEO4J_URI=bolt://localhost:7687
# Docker Compose: use service host
# NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Gemini API (Recommended - Fast & Low cost)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM (Ollama - Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ═══════════════════════════════════════════════════════════════════════════════
# Embedding Model Settings
# ═══════════════════════════════════════════════════════════════════════════════
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ═══════════════════════════════════════════════════════════════════════════════
# File Upload Settings
# ═══════════════════════════════════════════════════════════════════════════════
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
UPLOAD_DIR=uploads/syllabus

# Logging
LOG_LEVEL=INFO
