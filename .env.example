# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME="KTUfy Backend API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT Configuration (for your own JWT operations if needed)
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Redis Configuration (for Celery - will set up later)
REDIS_URL=redis://localhost:6379/0

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png

# Vector Database Settings
CHROMA_PERSIST_DIRECTORY=./vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Configuration (will configure later)
# Option 1: Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 2: OpenAI (if you want to use it later)
# OPENAI_API_KEY=your_openai_api_key_here

# Logging
LOG_LEVEL=INFO
